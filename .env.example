# Copy to .env.local for local overrides, or set these in your Vercel project.

# WebSocket control-plane server. In production set this to your deployed Render URL,
# using wss:// (an https page cannot open a ws:// connection).
#   e.g. wss://tassel-server.onrender.com
VITE_WS_URL=

# Optional: a default Daily room URL (otherwise paste it on the join screen).
#   e.g. https://yourname.daily.co/ceremony
VITE_DAILY_ROOM_URL=

# --- TURN relay (makes the built-in P2P video work across the internet) ---
# The video is peer-to-peer (browser -> browser). When a participant is behind a SYMMETRIC NAT /
# CGNAT (mobile data, many home ISPs) the two browsers can't connect directly and the encrypted
# media must be forwarded by a relay. STUN alone isn't enough there, and the old bundled free relay
# is dead.
#
# Run YOUR OWN relay (no third-party service) with the coturn setup in ./coturn — see
# coturn/README.md. It gives you a STUN+TURN server on your own VPS; then point the app at it:
#   VITE_ICE_SERVERS=[{"urls":"stun:YOUR_VPS_IP:3478"},{"urls":"turn:YOUR_VPS_IP:3478","username":"tassel","credential":"YOUR_SECRET"},{"urls":"turn:YOUR_VPS_IP:3478?transport=tcp","username":"tassel","credential":"YOUR_SECRET"}]
#
# (A hosted relay such as metered.ca uses the exact same VITE_ICE_SERVERS format, if you ever prefer one.)
# These are VITE_ (client) vars: inlined at BUILD time, so rebuild after changing them.
# NOTE: the repo commits a working default in `.env` (the project's own coturn relay); set this in
# .env.local only to OVERRIDE it for your machine.
VITE_ICE_SERVERS=
#
# Alternative to the JSON array — a single TURN server via separate fields (URLS may be comma-separated):
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# --- LiveKit (SFU video; scales to many cameras). When VITE_LIVEKIT_URL is set,
#     the app uses LiveKit instead of the built-in P2P mesh. ---
# The wss:// URL from your LiveKit Cloud project (or your self-hosted server).
VITE_LIVEKIT_URL=
# Server-side credentials used to sign join tokens. Keep secret; never commit.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
