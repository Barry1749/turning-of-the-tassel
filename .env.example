# Copy to .env.local for local overrides, or set these in your Vercel project.

# WebSocket control-plane server. In production set this to your deployed Render URL,
# using wss:// (an https page cannot open a ws:// connection).
#   e.g. wss://tassel-server.onrender.com
VITE_WS_URL=

# Optional: a default Daily room URL (otherwise paste it on the join screen).
#   e.g. https://yourname.daily.co/ceremony
VITE_DAILY_ROOM_URL=
