# Keep shell scripts LF so they run on macOS/Linux even when authored/checked out on Windows.
*.sh        text eol=lf
*.command   text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.mjs       text eol=lf
# Windows-only scripts use CRLF.
*.cmd       text eol=crlf
*.ps1       text eol=crlf
